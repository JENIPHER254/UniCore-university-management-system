# uniCore environment example — copy to .env and adjust
# Keep real secrets out of source control.

# API
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_HOURS=12
CORS_ORIGIN=http://localhost:5173

# Database (SQLite)
DATABASE_PATH=db/data/unicore.db

# Frontend
VITE_API_URL=http://localhost:4000

# Seed data (used by db/seeds only, safe values)
SEED_ADMIN_EMAIL=anna-admin@example.com
SEED_ADMIN_INITIAL_PASSWORD=ChangeMe2026!
